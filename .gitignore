# ============================================================
# DBVF_Sim (Unreal map project) .gitignore
# Derived from github/gitignore UnrealEngine.gitignore.
# Convention: root-level paths are explicitly anchored with a leading /.
# ============================================================

# ------------------------------------------------------------
# Engine / editor generated (all rebuilt automatically)
# ------------------------------------------------------------
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/

# Baked lighting/map data (regenerated by Build > Build Lighting)
*_BuiltData.uasset

# ------------------------------------------------------------
# Build output (Epic convention: keep PakBlacklist files + icons)
# ------------------------------------------------------------
/Build/*
!/Build/*/
/Build/*/**
!/Build/*/PakBlacklist*.txt
!/Build/**/*.ico

# ------------------------------------------------------------
# Plugins
# Third-party plugins (e.g. Cosys-AirSim) are fetched by
# Tools/fetch_deps.ps1, pinned in deps.json. Never committed.
# First-party plugins must be named DBVF* to be tracked.
# ------------------------------------------------------------
/Plugins/*
!/Plugins/DBVF*/
/Plugins/**/Binaries/
/Plugins/**/Intermediate/

# ------------------------------------------------------------
# Raw source art kept outside Content/ (Unreal convention)
# ------------------------------------------------------------
/SourceArt/**/*.png
/SourceArt/**/*.tga

# ------------------------------------------------------------
# Packaged builds (uploaded to GitHub Releases, never committed)
# ------------------------------------------------------------
/Dist/

# ------------------------------------------------------------
# Cross-platform: compiled artifacts
# ------------------------------------------------------------
*.o
*.a
*.pch
*.gch

# ------------------------------------------------------------
# Cross-platform: IDEs
# ------------------------------------------------------------
.idea/
.vscode/
*.code-workspace

# ------------------------------------------------------------
# Windows (MSVC + Visual Studio)
# ------------------------------------------------------------
*.obj
*.lib
*.dll
*.exe
/Backup/
.vs/
_UpgradeReport_Files/
UpgradeLog*.htm
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
.vsconfig

# ------------------------------------------------------------
# Linux (if needed)
# ------------------------------------------------------------
*.so
*.out
*.slo
*.lo
*.la
*.lai
/Makefile
/CMakeLists.txt

# ------------------------------------------------------------
# macOS / iOS (if needed)
# ------------------------------------------------------------
*.dylib
*.app
*.ipa
*.xcodeproj
*.xcworkspace
