# ============================================================
# DBVF_Sim .gitattributes
# ============================================================

# Default: Git detects text vs binary; text is stored with LF in the repo
# and checked out with the platform's native line endings.
* text=auto

# --- Unreal assets: binary, never converted, never diffed or merged ---
*.uasset binary
*.umap   binary

# --- Source art / media (if any lands outside Content/) ---
*.png binary
*.jpg binary
*.tga binary
*.exr binary
*.fbx binary
*.wav binary

# --- Unreal text formats ---
*.uproject text
*.uplugin  text
*.ini      text
*.json     text
*.cs       text
*.cpp      text diff=cpp
*.h        text diff=cpp

# --- Scripts: pin line endings, because the interpreters care ---
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
